      enchantedOnlyDesc: "Control the default display of the trade list; when enabled, only trades with enchantments are shown",
      scrollableCmdTitle: "Scrollable Command Input",
      scrollableCmdDesc: "Enable scrolling for the multi-line command input box, allowing longer commands to be edited",
