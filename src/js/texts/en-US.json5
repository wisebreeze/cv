      hotbarOffsetDesc: "Control whether to play an offset animation when showing or hiding the hotbar",
      tabToolboxTitle: "Allow Tab to Open Toolbox",
      tabToolboxDesc: "Hold the Tab key to display the HUD toolbar; press the corresponding number key in the hotbar to toggle features",
      dataOverviewTitle: "Data Overview",
      dataOverviewDesc: "Display precise values for clocks or compasses in the toolbox; requires the Data Overview extension",
      bottomMessageTitle: "Bottom Message",
      bottomMessageDesc: "Display messages in the bottom-left corner, using the Java edition HUD chat layout",
      equalMessageTitle: "Equal Length Message",
      equalMessageDesc: "When enabled, message backgrounds use a uniform length; when disabled, the width adapts to the text length",
      infoPositionTitle: "Information Display Position",
      infoPositionDesc: "Control whether information is displayed at the top or bottom of the screen",
      durabilityStyleTitle: "Durability Style",
      durabilityStyleDesc: "Control the durability text format: Detail shows the current durability value, Percentage shows the ratio of current to total durability",
      oreDistTitle: "Ore Distribution",
      oreDistDesc: "Display the generation probability of various ores at the current Y coordinate, based on 1.18+ standard distribution; requires both panel and chunk map extensions",
