      operationAllDesc: "Perform take-all or store-all operations on items in the inventory or container",
      toolboxSidebarTitle: "Toolbox Sidebar",
      toolboxSidebarDesc: "Filter specific items such as enchanted items or shulker boxes; click to transfer to container or inventory, and display capacity information",
      hoverTextTitle: "Hover Text",
      hoverTextDesc: "Display the item name and detail tooltip when the pointer hovers over an item",
      touchHoverPosTitle: "Touch Hover Text Position",
      touchHoverPosDesc: "Control the display position of hover text in touch mode; takes effect after disabling the hover text switch",
      gridSpacingTitle: "Item Grid Spacing",
      gridSpacingDesc: "Add grid spacing to item backgrounds, making each cell independent for easier visual distinction",
