      chainMoveDesc: "Move all items of the same type to the container or inventory when clicking an item",
      redstoneEnergyTitle: "Redstone Energy",
      redstoneEnergyDesc: "Display the redstone signal strength output by the container through a redstone comparator",
      betaDebugTextTitle: "Beta Debug Text",
      betaDebugTextDesc: "Control the display of device information and related debug text at the top in beta versions",
      progressPercentTitle: "Progress Percentage",
      progressPercentDesc: "Display the current progress percentage value next to the progress bar",
