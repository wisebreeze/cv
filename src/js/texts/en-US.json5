      assistCrosshairDesc: "Display an assist crosshair when holding throwable items",
      unconditionalDisplayTitle: "Unconditional Display",
      unconditionalDisplayDesc: "Display the assist crosshair unconditionally, not limited to holding throwable items",
      nonTouchModeTitle: "Non-touch Mode Switch",
      nonTouchModeDesc: "Automatically hide auxiliary buttons when non-touch input is detected, adapting to keyboard and mouse scenarios",
