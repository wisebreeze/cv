      quickAccessDesc: "Quickly adjust certain settings via the settings button in the pause menu during gameplay",
      worldAdvancedTitle: "World Advanced Settings",
      worldAdvancedDesc: "Access hidden advanced settings options, such as exporting worlds or templates on mobile",
      forceSpectatorTitle: "Force Spectator Mode",
      forceSpectatorDesc: "Allow using spectator mode without enabling cheats, without affecting achievement acquisition",
      viewPathTitle: "View Path",
      viewPathDesc: "View the file storage paths for resource packs, behavior packs, and other content",
      oldWorldTitle: "Old World",
      oldWorldDesc: "Allow users to select the old world type for creation",
      fluencyTitle: "Fluency",
      fluencyDesc: "Control the display of the fluency estimation progress bar at the top of video settings",
      moreDropdownTitle: "Show More Dropdown Options",
      moreDropdownDesc: "Expand dropdown settings to show more available options",
      enhancedCmdTitle: "Enhanced Command Display",
      enhancedCmdDesc: "Allow browsing more options by scrolling during command selection",
      vanillaBgTitle: "Use Original Background",
      vanillaBgDesc: "Use the original panorama as the background",
